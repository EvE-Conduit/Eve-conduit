# --- Required -----------------------------------------------------------------
# Long random string. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
CONDUIT_SECRET_KEY=
POSTGRES_PASSWORD=

# Public address of the site. Caddy gets an HTTPS certificate for CONDUIT_DOMAIN automatically.
CONDUIT_DOMAIN=auth.example.com
CONDUIT_SITE_URL=https://auth.example.com
CONDUIT_ALLOWED_HOSTS=auth.example.com

# From https://developers.eveonline.com/applications
# Callback URL to register there: https://auth.example.com/sso/callback
ESI_CLIENT_ID=
ESI_SECRET_KEY=

# CCP asks every ESI app to identify itself. An email address is strongly preferred.
ESI_USER_AGENT_CONTACT=admin@example.com

# Key for encrypting stored EVE logins (Fernet). Strongly recommended; without it one is derived from
# CONDUIT_SECRET_KEY. Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# On an existing install, set it and then run: docker compose exec web python manage.py rotate_token_key
CONDUIT_TOKEN_KEY=

# --- Optional -----------------------------------------------------------------
# Old token keys still accepted while rotate_token_key re-encrypts (comma separated).
# CONDUIT_TOKEN_KEY_PREVIOUS=
# Remove the Django back-office at /django-admin/ entirely.
# CONDUIT_DJANGO_ADMIN=false
# Per-IP limits on EVE login, the setup code and failed API keys. Only switch off if the proxy limits these.
# CONDUIT_RATE_LIMITS=true
# Let webhooks post to private/internal addresses (off by default; see docs/security.md).
# CONDUIT_WEBHOOK_ALLOW_PRIVATE=false
# WEB_WORKERS=3
# WORKER_CONCURRENCY=4
# CONDUIT_LOG_LEVEL=INFO
# Days to keep the audit, API request and service logs (0 = forever). See docs/external-api.md.
# CONDUIT_AUDIT_LOG_DAYS=365
# CONDUIT_API_LOG_DAYS=90
# CONDUIT_SERVICE_LOG_DAYS=30
# CONDUIT_ESI_LOG_DAYS=7
# Record ESI calls: all, errors (only failures) or off.
# CONDUIT_ESI_LOG=all
