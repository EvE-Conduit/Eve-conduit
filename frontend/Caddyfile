# CONDUIT_DOMAIN=auth.example.com gives automatic HTTPS; the default ":80" serves plain HTTP.
{$CONDUIT_DOMAIN::80} {
	encode zstd gzip

	@backend path /api/* /sso/* /django-admin* /static/*
	handle @backend {
		reverse_proxy web:8000
	}

	handle {
		root * /srv
		# Nothing is cached: browsers check back on every load (a quick 304 when nothing changed).
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
