# CONDUIT_DOMAIN=auth.example.com gives automatic HTTPS; the default ":80" serves plain HTTP.
# CONDUIT_DOMAIN=203.0.113.7 (a public IPv4 address) gets a Let's Encrypt IP address certificate: caddy-entrypoint.sh
# sets CONDUIT_TLS=ip, which picks the snippet below.

# A domain: Caddy's automatic HTTPS as usual.
(tls-auto) {
}

# An IP address: Caddy would use its own self-signed certificate. Let's Encrypt issues IP certificates only with
# its six-day "shortlived" profile; Caddy renews them by itself.
(tls-ip) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

{$CONDUIT_DOMAIN::80} {
	import tls-{$CONDUIT_TLS:auto}
	encode zstd gzip

	@backend path /api/* /sso/* /django-admin* /static/*
	handle @backend {
		reverse_proxy web:8000
	}

	handle {
		root * /srv
		# Nothing is cached: browsers check back on every load (a quick 304 when nothing changed).
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# Browsers only act on this over HTTPS (plain ":80" installs send it harmlessly).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# No script-src on purpose: index.html carries an inline theme script and Vite's inline import map,
		# whose hashes change with every build and can't be pinned here.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
