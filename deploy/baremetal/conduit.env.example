# /etc/conduit/conduit.env  (owner root, group conduit, mode 0640)
# The installer fills this in; edit it and run "sudo conduit restart" to apply changes.

CONDUIT_SECRET_KEY=change-me
CONDUIT_TOKEN_KEY=
CONDUIT_SITE_URL=https://auth.example.com
CONDUIT_ALLOWED_HOSTS=auth.example.com
CONDUIT_STATIC_ROOT=/var/www/conduit/static

# PostgreSQL (recommended) ...
DATABASE_URL=postgres://conduit:PASSWORD@127.0.0.1:5432/conduit
# ... or MariaDB:
# DATABASE_URL=mysql://conduit:PASSWORD@127.0.0.1:3306/conduit

REDIS_URL=redis://127.0.0.1:6379/0

# From https://developers.eveonline.com/applications
# Callback URL to register there: https://auth.example.com/sso/callback
ESI_CLIENT_ID=
ESI_SECRET_KEY=
# CCP asks every ESI application to identify itself; an email is strongly preferred.
ESI_USER_AGENT_CONTACT=admin@example.com

# Security switches, see docs/security.md:
# CONDUIT_TOKEN_KEY_PREVIOUS=
# CONDUIT_DJANGO_ADMIN=false
# CONDUIT_RATE_LIMITS=true
# CONDUIT_WEBHOOK_ALLOW_PRIVATE=false
# CONDUIT_BIND=127.0.0.1:8000
# WEB_WORKERS=3
# WORKER_CONCURRENCY=4
# CONDUIT_LOG_LEVEL=INFO
