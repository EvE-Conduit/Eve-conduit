# /etc/evecsm/evecsm.env  (owner root, group evecsm, mode 0640)
# The installer fills this in; edit it and run "sudo evecsm restart" to apply changes.

EVECSM_SECRET_KEY=change-me
EVECSM_TOKEN_KEY=
EVECSM_SITE_URL=https://auth.example.com
EVECSM_ALLOWED_HOSTS=auth.example.com
EVECSM_STATIC_ROOT=/var/www/evecsm/static

# PostgreSQL (recommended) ...
DATABASE_URL=postgres://evecsm:PASSWORD@127.0.0.1:5432/evecsm
# ... or MariaDB:
# DATABASE_URL=mysql://evecsm:PASSWORD@127.0.0.1:3306/evecsm

REDIS_URL=redis://127.0.0.1:6379/0

# From https://developers.eveonline.com/applications
# Callback URL to register there: https://auth.example.com/sso/callback
ESI_CLIENT_ID=
ESI_SECRET_KEY=
# CCP asks every ESI application to identify itself; an email is strongly preferred.
ESI_USER_AGENT_CONTACT=admin@example.com

# Security switches, see docs/security.md:
# EVECSM_TOKEN_KEY_PREVIOUS=
# EVECSM_DJANGO_ADMIN=false
# EVECSM_RATE_LIMITS=true
# EVECSM_WEBHOOK_ALLOW_PRIVATE=false
# EVECSM_BIND=127.0.0.1:8000
# WEB_WORKERS=3
# WORKER_CONCURRENCY=4
# EVECSM_LOG_LEVEL=INFO
