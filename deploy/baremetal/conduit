#!/usr/bin/env bash
# conduit: day-to-day administration of a bare-metal EvE Conduit install.
#
#   conduit status | start | stop | restart [web|worker|beat]
#   conduit logs [web|worker|beat]        follow a service log
#   conduit manage <command> [args]       run a Django management command
#   conduit setup-code                    show the first-run setup code
#   conduit upgrade <release.tar.gz>      install a new release (keeps the old one for rollback)
#   conduit rollback                      switch back to the previous release
#   conduit backup                        dump the database and config to /var/backups/conduit
#   conduit restore <backup>              put a backup's database back (a file in /var/backups/conduit, or its
#                                         name); backs up the current one first and keeps this server's conduit.env
#   conduit apply-update                  install an update or plugins approved on the website, or make or
#                                         restore a backup asked for there (run as root by
#                                         the conduit-update.path watcher, with cron as a backup)
#   conduit setup-updater                 (re)install that watcher
#   conduit web-headers                   stop browsers caching the site (older nginx configs; upgrades do it)
#   conduit ip-cert                       HTTPS for a site on an IP address (no domain): get, install and keep
#                                         renewing a Let's Encrypt IP address certificate
#   conduit plugin install <package>      install a plugin (PyPI name, git URL or path)
#   conduit plugin list                   list installed plugins
#   conduit uninstall [--mode all|keep-data] remove EvE Conduit (asks what to keep; never deletes a user account)
#   conduit run web|worker|beat           used by Supervisor to start the services
set -euo pipefail

CONDUIT_HOME=${CONDUIT_HOME:-/opt/conduit}
CONDUIT_ETC=${CONDUIT_ETC:-/etc/conduit}
CONDUIT_WWW=${CONDUIT_WWW:-/var/www/conduit}
CONDUIT_LOG=${CONDUIT_LOG:-/var/log/conduit}
CONDUIT_BACKUPS=${CONDUIT_BACKUPS:-/var/backups/conduit}
CONDUIT_STATE=${CONDUIT_STATE:-/var/lib/conduit}
CONDUIT_USER=${CONDUIT_USER:-conduit}
CRON_DIR=${CRON_DIR:-/etc/cron.d}
APP="$CONDUIT_HOME/app"
VENV="$CONDUIT_HOME/venv"
ENV_FILE="$CONDUIT_ETC/conduit.env"
PLUGINS_FILE="$CONDUIT_ETC/plugins.txt"
# Plugins installed from Administration -> Plugins (written only by apply-update) and the newest catalog it used.
PLUGINS_SITE_FILE="$CONDUIT_ETC/plugins-site.txt"
PLUGIN_SERIAL_FILE="$CONDUIT_ETC/plugin-catalog.serial"
# This script, installed from each release so fixes to it arrive with updates.
CONDUIT_BIN=${CONDUIT_BIN:-/usr/local/bin/conduit}
SUPERVISOR_GROUP=conduit
# Steps whose failure must be noticed run as a new process of this script: inside "if ( ... )" bash ignores set -e.
SELF=$(readlink -f "${BASH_SOURCE[0]}")

die() { echo "conduit: $*" >&2; exit 1; }

# CONDUIT_TESTING=1 lets the test suite drive a sandboxed install without root.
require_root() { [[ $EUID -eq 0 || "${CONDUIT_TESTING:-}" == 1 ]] || die "run as root (sudo conduit ...)"; }

load_env() {
  [[ -r "$ENV_FILE" ]] || die "cannot read $ENV_FILE (run as root or the $CONDUIT_USER user)"
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  export DJANGO_SETTINGS_MODULE=conduit.settings
}

# Run a command as the service user (we may already be it).
as_service() {
  if [[ "$(id -un)" == "$CONDUIT_USER" ]]; then
    "$@"
  else
    require_root
    runuser -u "$CONDUIT_USER" -- "$@"
  fi
}

manage() {
  load_env
  as_service env "PATH=$VENV/bin:$PATH" "$VENV/bin/python" "$APP/backend/manage.py" "$@"
}

supervisor() { command -v supervisorctl >/dev/null || die "supervisorctl not found"; supervisorctl "$@"; }

publish_web() {
  # nginx serves the prebuilt front end from /var/www (SELinux-friendly on RHEL family).
  local src="$1/web"
  [[ -d "$src" ]] || die "release has no web/ directory"
  mkdir -p "$CONDUIT_WWW/web.new"
  cp -a "$src/." "$CONDUIT_WWW/web.new/"
  rm -rf "$CONDUIT_WWW/web.old"
  [[ -d "$CONDUIT_WWW/web" ]] && mv "$CONDUIT_WWW/web" "$CONDUIT_WWW/web.old"
  mv "$CONDUIT_WWW/web.new" "$CONDUIT_WWW/web"
  rm -rf "$CONDUIT_WWW/web.old"
}

# Plugins depend on "conduit" by name, and PyPI has an unrelated package called conduit. Every pip run that installs
# plugins gets this constraints file, so pip can only satisfy that dependency with the backend installed here and
# never downloads a stranger's package in its place. Prints the file's path (inside the root-owned venv).
pip_constraints() {
  local file="$VENV/pip-constraints.txt"
  "$VENV/bin/python" -I -m conduit.plugins.installer constraints >"$file"
  echo "$file"
}

install_python() {
  # Backend plus every plugin in plugins.txt (paths are relative to the release) and plugins-site.txt.
  # Runs as root: the venv is root-owned so the service can't modify its own code.
  local release="$1" extras="" constraints
  require_root
  load_env
  [[ "${DATABASE_URL:-}" == mysql* ]] && extras="[mysql]"
  (cd "$release" && "$VENV/bin/python" -m pip install --quiet --upgrade "./backend$extras")
  constraints=$(pip_constraints)   # after the backend: it pins the version just installed
  if [[ -s "$PLUGINS_FILE" ]]; then
    (cd "$release" && "$VENV/bin/python" -m pip install --quiet --upgrade -c "$constraints" -r "$PLUGINS_FILE")
  fi
  if grep -qv '^\s*\(#\|$\)' "$PLUGINS_SITE_FILE" 2>/dev/null; then
    (cd "$release" && "$VENV/bin/python" -m pip install --quiet --upgrade -c "$constraints" -r "$PLUGINS_SITE_FILE")
  fi
}

# Root writes into two folders the service user owns: the updates folder (results, progress) and the log folder. A
# compromised site could plant a symlink there for root to follow, so every such read and write goes through
# conduit.updates.safeio, which opens nothing through a symlink and replaces files by rename.
safeio() { "$VENV/bin/python" -I -m conduit.updates.safeio "$@"; }
UPDATER_LOG="$CONDUIT_LOG/updater.log"
log_line() { safeio append "$UPDATER_LOG" "$(date -Is) $*"; }
# Run a command with its output appended to the updater log; returns the command's own exit status.
log_run() { "$@" 2>&1 | safeio append "$UPDATER_LOG"; return "${PIPESTATUS[0]}"; }

# How far an update has got, for Administration -> Updates / Plugins and the banner members see:
# <updates>/progress.json, removed when the update is over. "progress <release|plugins|restore> <version|-> <step>"
# with step backup, install (restore: restore), migrate or restart; "progress clear" removes it.
progress() {
  local dir="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}" now
  [[ -d "$dir" ]] || return 0
  if [[ "$1" == clear ]]; then rm -f "$dir/progress.json"; return 0; fi
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  export PROGRESS_STARTED=${PROGRESS_STARTED:-$now}
  safeio write-json "$dir/progress.json" "kind=$1" "target=${2#-}" "step=$3" "started_at=$PROGRESS_STARTED" "at=$now" || return 0
}

install_admin_script() {  # release dir
  [[ "${CONDUIT_TESTING:-}" == 1 ]] && return 0
  install -m 0755 "$1/deploy/baremetal/conduit" "$CONDUIT_BIN"
}

cmd_web_headers() {
  # Sites installed before 0.5.13 let browsers cache /static/ for 7 days and /assets/ for a year. Switch both to
  # "check back every time" (expires -1 sends Cache-Control: no-cache), leaving the rest of the config alone.
  require_root
  [[ "${CONDUIT_TESTING:-}" == 1 ]] && return 0
  local conf
  for conf in /etc/nginx/sites-available/conduit.conf /etc/nginx/conf.d/conduit.conf; do
    [[ -f "$conf" ]] || continue
    grep -qE 'expires 7d;|max-age=31536000, immutable' "$conf" || { echo "nginx: $conf already sends no-cache"; continue; }
    cp -a "$conf" "$conf.bak"
    sed -i -E -e 's/expires 7d;/expires -1;/' \
      -e 's/add_header Cache-Control "public, max-age=31536000, immutable" always;/expires -1;/' "$conf"
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx 2>/dev/null || nginx -s reload
      rm -f "$conf.bak"
      echo "nginx: browsers no longer cache the site ($conf)"
    else
      mv "$conf.bak" "$conf"
      echo "nginx: $conf didn't pass 'nginx -t' after the change, so it was left as it was" >&2
    fi
  done
}

finish_deploy() {
  manage migrate --noinput
  manage collectstatic --noinput -v0
  manage conduit_init
}

cmd_upgrade() {
  local tarball="${1:-}"
  require_root
  [[ -f "$tarball" ]] || die "usage: conduit upgrade <eve-conduit-X.Y.Z.tar.gz>"
  local version
  version=$(tar -xzOf "$tarball" --wildcards '*/VERSION' | head -1)
  [[ -n "$version" ]] || die "not an EvE Conduit release (no VERSION file)"
  local target="$CONDUIT_HOME/releases/$version"
  [[ "$(readlink -f "$APP")" == "$target" ]] && die "release $version is already the running release"
  load_env
  progress release "$version" backup
  echo "Backing up before upgrading..."
  cmd_backup
  # Unpack and install from a staging directory; it only becomes a release once everything worked,
  # so a failed upgrade can simply be retried.
  local staging="$target.partial"
  rm -rf "$staging" "$target"
  mkdir -p "$staging"
  # shellcheck disable=SC2064  # expand now: $staging is local and gone when the trap fires
  trap "rm -rf '$staging'" EXIT
  tar -xzf "$tarball" -C "$staging" --strip-components=1
  [[ "${CONDUIT_TESTING:-}" == 1 ]] || chown -R root:"$CONDUIT_USER" "$staging"
  echo "Installing $version..."
  progress release "$version" install
  install_python "$staging"
  mv "$staging" "$target"
  trap - EXIT
  local previous
  previous=$(readlink -f "$APP" || true)
  ln -sfn "$target" "$APP"
  [[ -n "$previous" ]] && ln -sfn "$previous" "$CONDUIT_HOME/previous"
  progress release "$version" migrate
  finish_deploy
  publish_web "$target"
  install_admin_script "$target"
  # The release's own admin script knows its web server settings (this one may be older).
  [[ "${CONDUIT_TESTING:-}" == 1 ]] || "$CONDUIT_BIN" web-headers || true
  progress release "$version" restart
  supervisor restart "$SUPERVISOR_GROUP:*"
  progress clear
  echo "EvE Conduit $version is running. 'conduit rollback' returns to the previous release."
}

cmd_rollback() {
  require_root
  local previous
  previous=$(readlink -f "$CONDUIT_HOME/previous" 2>/dev/null || true)
  [[ -d "$previous" ]] || die "no previous release recorded"
  local current
  current=$(readlink -f "$APP")
  echo "Rolling back to $(basename "$previous"). Database changes made by newer migrations are NOT undone;"
  echo "restore the backup taken before the upgrade if the old version refuses to start."
  install_python "$previous"
  ln -sfn "$previous" "$APP"
  ln -sfn "$current" "$CONDUIT_HOME/previous"
  manage collectstatic --noinput -v0
  publish_web "$previous"
  install_admin_script "$previous"
  supervisor restart "$SUPERVISOR_GROUP:*"
}

# The website can't read the backups folder, so the updater lists it in the updates folder (conduit.updates.restore).
restore_py() { "$VENV/bin/python" -I -m conduit.updates.restore "$@"; }
refresh_backup_index() {
  local updates="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}"
  [[ -d "$updates" && -d "$CONDUIT_BACKUPS" ]] || return 0
  restore_py index "$CONDUIT_BACKUPS" "$updates" --owner "$CONDUIT_USER" || true
}

# cmd_backup [suffix]: the file it wrote is left in LAST_BACKUP.
LAST_BACKUP=""
cmd_backup() {
  require_root
  load_env
  local stamp dir suffix="${1:+-$1}"
  stamp=$(date +%Y%m%d-%H%M%S)
  dir=$(mktemp -d)
  mkdir -p "$CONDUIT_BACKUPS"
  chmod 700 "$CONDUIT_BACKUPS"
  "$VENV/bin/python" - "$DATABASE_URL" "$dir" <<'PY'
import os, subprocess, sys
from urllib.parse import unquote, urlparse
url, out = urlparse(sys.argv[1]), sys.argv[2]
env = dict(os.environ)
if url.scheme.startswith("postgres"):
    env["PGPASSWORD"] = unquote(url.password or "")
    cmd = ["pg_dump", "-h", url.hostname or "localhost", "-p", str(url.port or 5432), "-U", unquote(url.username or ""), "-Fc", "-f", f"{out}/database.dump", url.path.lstrip("/")]
elif url.scheme.startswith("mysql"):
    env["MYSQL_PWD"] = unquote(url.password or "")
    dump = "mariadb-dump" if subprocess.run(["which", "mariadb-dump"], capture_output=True).returncode == 0 else "mysqldump"
    cmd = [dump, "-h", url.hostname or "localhost", "-P", str(url.port or 3306), "-u", unquote(url.username or ""), "--single-transaction", "--routines", f"--result-file={out}/database.sql", url.path.lstrip("/")]
else:
    sys.exit(f"don't know how to back up {url.scheme}")
subprocess.run(cmd, env=env, check=True)
PY
  cp "$ENV_FILE" "$dir/conduit.env"
  [[ -f "$PLUGINS_FILE" ]] && cp "$PLUGINS_FILE" "$dir/plugins.txt"
  [[ -f "$PLUGINS_SITE_FILE" ]] && cp "$PLUGINS_SITE_FILE" "$dir/plugins-site.txt"
  readlink -f "$APP" > "$dir/release.txt" || true
  LAST_BACKUP="$CONDUIT_BACKUPS/conduit-$stamp$suffix.tar.gz"
  tar -czf "$LAST_BACKUP" -C "$dir" .
  chmod 600 "$LAST_BACKUP"
  rm -rf "$dir"
  refresh_backup_index
  echo "Backup written to $LAST_BACKUP (contains secrets; keep it safe)"
}

# Load an unpacked backup's database, then migrate it up to this release and carry its EVE login keys over. Every
# step is checked by hand: callers run this inside "if", where set -e does nothing.
restore_steps() {  # unpacked backup folder, backup name, requested by
  restore_py load-db "$1" || return 1
  progress restore - migrate
  manage migrate --noinput || return 1
  manage conduit_init >/dev/null || return 1
  if [[ -f "$1/conduit.env" ]]; then
    local added
    added=$(restore_py carry-keys "$ENV_FILE" "$1/conduit.env") || return 1
    [[ "$added" == 0 ]] || echo "Added $added of the backup's EVE login keys to CONDUIT_TOKEN_KEY_PREVIOUS in $ENV_FILE."
  fi
  manage rotate_token_key || echo "Warning: some stored EVE logins couldn't be re-encrypted; those members sign in again." >&2
  manage after_restore "$2" --requested-by "$3" || return 1
}

cmd_restore() {  # backup file or name, [who asked on the website]
  require_root
  local archive="${1:-}" by="${2:-}"
  [[ -n "$archive" && ! -f "$archive" && -f "$CONDUIT_BACKUPS/$archive" ]] && archive="$CONDUIT_BACKUPS/$archive"
  [[ -f "$archive" ]] || die "usage: conduit restore <backup> (a file in $CONDUIT_BACKUPS, or its name)"
  load_env
  local name work version safety
  name=$(basename "$archive")
  work=$(mktemp -d)
  # shellcheck disable=SC2064  # expand now: $work is local and gone when the trap fires
  trap "rm -rf '$work'; progress clear" EXIT
  # Refuses a backup made by a newer EvE Conduit before anything is touched.
  version=$(restore_py unpack "$archive" "$work/backup") || die "can't restore $name"
  echo "Restoring $name (made by EvE Conduit $version). The site is offline until it's done."
  progress restore - backup
  echo "Backing up the current database first..."
  cmd_backup before-restore
  safety=$LAST_BACKUP
  cp -p "$ENV_FILE" "$work/conduit.env.before"
  supervisor stop "$SUPERVISOR_GROUP:*" || true
  progress restore - restore
  if ! restore_steps "$work/backup" "$name" "$by"; then
    echo "Restoring $name failed. Putting the database back as it was..." >&2
    cp -p "$work/conduit.env.before" "$ENV_FILE"
    if ! { restore_py unpack "$safety" "$work/safety" >/dev/null && restore_py load-db "$work/safety" \
           && manage migrate --noinput; }; then
      echo "PUTTING THE DATABASE BACK FAILED TOO. Restore $safety by hand: sudo conduit restore $safety" >&2
    fi
    supervisor start "$SUPERVISOR_GROUP:*" || true
    progress clear
    die "restoring $name failed; the database is as it was before (details above)"
  fi
  progress restore - restart
  supervisor start "$SUPERVISOR_GROUP:*"
  progress clear
  echo "Restored $name. The database as it was just before is in $safety."
}

cmd_plugin() {
  case "${1:-}" in
    install)
      local pkg="${2:-}"
      [[ -n "$pkg" ]] || die "usage: conduit plugin install <package|git URL|path>"
      require_root
      grep -qxF "$pkg" "$PLUGINS_FILE" 2>/dev/null || echo "$pkg" >> "$PLUGINS_FILE"
      install_python "$(readlink -f "$APP")"
      finish_deploy
      supervisor restart "$SUPERVISOR_GROUP:*"
      echo "Installed. Switch it on under Administration -> Plugins."
      ;;
    list)
      manage shell -c "from conduit.plugins import registry
for mid, e in sorted(registry.discover().items()):
    print(f\"{mid:20} {e.plugin.version:10} {'OK' if e.ok else 'BROKEN: ' + '; '.join(e.problems)}\")"
      ;;
    *) die "usage: conduit plugin install <package> | conduit plugin list" ;;
  esac
}

# The website (running as the conduit user) downloads and verifies releases into the updates folder and leaves
# install-request.json there when an admin clicks Install, or plugins-request.json when they install or remove
# plugins. systemd's conduit-update.path starts this the moment such a file appears; /etc/cron.d/conduit-update
# also runs it every two minutes, as a backup and on systems without systemd. A lock keeps the two apart.
cmd_apply_update() {
  require_root
  load_env
  local lock=${CONDUIT_UPDATE_LOCK:-/run/lock/conduit-update.lock}
  exec 9>"$lock"
  if [[ -n "${INVOCATION_ID:-}" ]]; then
    # Started by systemd: wait for a run already in progress. Returning straight away while the request file is
    # still there would make conduit-update.path trigger again and again.
    flock 9
  else
    flock -n 9 || return 0   # cron: a run is already in progress
  fi
  # Installs from before the watcher existed get it on the first run of this (newer) script.
  install_update_watcher
  apply_release_request
  apply_plugin_request
  apply_backup_request
  refresh_backup_index
}

# conduit-update.path watches the updates folder and starts conduit-update.service ("conduit apply-update") as soon
# as a request appears, so updates start within seconds instead of at the next cron run. Rewritten only when it
# changed. Does nothing without systemd (cron alone then).
install_update_watcher() {
  [[ "${CONDUIT_TESTING:-}" == 1 ]] && return 0
  command -v systemctl >/dev/null && [[ -d /run/systemd/system ]] || return 0
  local updates="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}" dir=/etc/systemd/system changed=0 unit want
  for unit in service path; do
    if [[ $unit == service ]]; then
      want="[Unit]
Description=EvE Conduit: install an update or plugins approved on the website

[Service]
Type=oneshot
ExecStart=$CONDUIT_BIN apply-update
# An upgrade backs up the database and reinstalls packages; give it time.
TimeoutStartSec=2h"
    else
      want="[Unit]
Description=EvE Conduit: start the updater when the website asks for an install

[Path]
PathExistsGlob=$updates/*-request.json
Unit=conduit-update.service

[Install]
WantedBy=multi-user.target"
    fi
    if [[ "$(cat "$dir/conduit-update.$unit" 2>/dev/null)" != "$want" ]]; then
      printf '%s\n' "$want" >"$dir/conduit-update.$unit"
      changed=1
    fi
  done
  if [[ $changed == 1 ]]; then
    systemctl daemon-reload
    systemctl enable conduit-update.path >/dev/null 2>&1 || true
    # Not --now from inside conduit-update.service: the path unit would queue this service again straight away.
    systemctl start --no-block conduit-update.path || true
  fi
  return 0
}

cmd_setup_updater() {
  require_root
  load_env
  install_update_watcher
}

# Nothing in the updates folder is trusted: the request is read without following symlinks, the release is copied
# (plain files only) to a root-only temp dir and its signature checked again with the installed EvE Conduit, and a
# release older than the running one is refused, before the normal upgrade runs.
apply_release_request() {
  local updates="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}"
  local request="$updates/install-request.json" result="$updates/install-result.json"
  [[ -e "$request" || -L "$request" ]] || return 0
  local version
  version=$(safeio read-json "$request" 2>/dev/null | "$VENV/bin/python" -I -c '
import json, re, sys
r = json.load(sys.stdin)
v = str(r.get("version", ""))
ok = re.fullmatch(r"\d{1,4}\.\d{1,4}\.\d{1,4}", v) and r.get("file") == "eve-conduit-%s.tar.gz" % v
print(v if ok else "")' 2>/dev/null || true)
  rm -f "$request"   # one attempt per request
  if [[ -z "$version" ]]; then
    log_line "rejected an invalid update request"
    return 0
  fi
  write_result() {  # status message
    safeio write-json "$result" --owner "$CONDUIT_USER" --stamp "version=$version" "status=$1" "message=$2"
  }
  # A signed release is still an old release: never go backwards (equal is a reinstall).
  local running
  if ! running=$("$VENV/bin/python" -I -m conduit.updates.versions check-upgrade "$version"); then
    log_line "refused to install $version over the running $running"
    write_result failed "$version is older than the running $running; EvE Conduit doesn't install older versions."
    return 0
  fi
  local file="eve-conduit-$version.tar.gz" work name
  work=$(mktemp -d)
  write_result running "Installing $version"
  for name in "$file" SHA256SUMS SHA256SUMS.sig; do
    if ! log_run safeio copy-regular "$updates/$name" "$work/$name"; then
      write_result failed "The downloaded release is missing (details in $UPDATER_LOG)"; rm -rf "$work"; return 0
    fi
  done
  local check
  if ! check=$("$VENV/bin/python" -I -m conduit.updates.verify "$work/$file" "$work/SHA256SUMS" "$work/SHA256SUMS.sig" 2>&1); then
    log_line "$check"
    write_result failed "The release failed its signature check: $check"; rm -rf "$work"; return 0
  fi
  log_line "installing $version: $check"
  if log_run "$SELF" upgrade "$work/$file"; then
    progress clear
    write_result succeeded "EvE Conduit $version is running."
  else
    log_line "upgrade to $version failed; putting the running release back"
    log_run install_python "$(readlink -f "$APP")" || true
    log_run supervisor restart "$SUPERVISOR_GROUP:*" || true
    progress clear
    write_result failed "The upgrade to $version failed and the previous version was put back (details in $UPDATER_LOG)."
  fi
  rm -rf "$work"
}

# The request is checked by conduit.plugins.installer (signed catalog, pinned versions, git URLs only if this
# server's conduit.env allows them), which writes the new plugins-site.txt.new. Then: back up, pip, migrate,
# restart; if anything fails, the previous plugin list is put back.
apply_plugin_request() {
  local updates="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}"
  local request="$updates/plugins-request.json"
  [[ -e "$request" || -L "$request" ]] || return 0
  local helper=("$VENV/bin/python" -I -m conduit.plugins.installer)
  local plan id="" summary="" kind value reason
  local -a uninstall=() reinstall=()
  reason=$(mktemp)
  # The helper reads the request through safeio (never a symlink) and leaves the result owned by the service user.
  if ! plan=$("${helper[@]}" prepare "$updates" "$PLUGINS_SITE_FILE" "$PLUGIN_SERIAL_FILE" --env-file "$ENV_FILE" --owner "$CONDUIT_USER" 2>"$reason"); then
    log_line "refused a plugin request: $(cat "$reason")"
    rm -f "$reason"
    return 0
  fi
  rm -f "$reason"
  while IFS=$'\t' read -r kind value; do
    case "$kind" in
      id) id=$value ;;
      summary) summary=$value ;;
      uninstall) uninstall+=("$value") ;;
      reinstall) reinstall+=("$value") ;;
    esac
  done <<<"$plan"
  plugin_result() {  # status message
    "${helper[@]}" result "$updates" "$id" "$1" "$2" --owner "$CONDUIT_USER"
  }
  plugin_result running "Installing: $summary"
  log_line "plugins: $summary"
  local before
  before=$("${helper[@]}" dists | sort)
  if [[ -f "$PLUGINS_SITE_FILE" ]]; then cp -p "$PLUGINS_SITE_FILE" "$PLUGINS_SITE_FILE.bak"; else : >"$PLUGINS_SITE_FILE.bak"; fi
  mv "$PLUGINS_SITE_FILE.new" "$PLUGINS_SITE_FILE"
  chown root:"$CONDUIT_USER" "$PLUGINS_SITE_FILE" 2>/dev/null || true
  chmod 0640 "$PLUGINS_SITE_FILE"
  local -a steps=()
  for pkg in "${uninstall[@]}"; do steps+=("uninstall=$pkg"); done
  for url in "${reinstall[@]}"; do steps+=("reinstall=$url"); done
  if log_run "$SELF" _apply-plugins "${steps[@]}"; then
    rm -f "$PLUGINS_SITE_FILE.bak"
    progress clear
    plugin_result succeeded "The site has restarted with the changes."
  else
    log_line "plugin change failed; putting the previous plugins back"
    mv "$PLUGINS_SITE_FILE.bak" "$PLUGINS_SITE_FILE"
    local added
    added=$(comm -13 <(echo "$before") <("${helper[@]}" dists | sort))
    for pkg in $added; do log_run "$VENV/bin/python" -m pip uninstall --quiet --yes "$pkg" || true; done
    log_run install_python "$(readlink -f "$APP")" || true
    log_run finish_deploy || true
    log_run supervisor restart "$SUPERVISOR_GROUP:*" || true
    progress clear
    plugin_result failed "That didn't work, so the previous plugins were put back (details in $UPDATER_LOG)."
  fi
}

# "Back up now" or "Restore" under Administration -> Backups. conduit.updates.restore checks the request (a restore
# must name a plain file in the backups folder) and removes it; the result goes to backup-result.json.
apply_backup_request() {
  local updates="${CONDUIT_UPDATES_DIR:-$CONDUIT_STATE/updates}"
  [[ -e "$updates/backup-request.json" || -L "$updates/backup-request.json" ]] || return 0
  local line action id name by
  if ! line=$(restore_py request "$updates" "$CONDUIT_BACKUPS" 2>&1); then
    log_line "rejected a backup request: $line"
    return 0
  fi
  IFS=$'\t' read -r action id name by <<<"$line"
  [[ "$name" == - ]] && name=""
  [[ "$by" == - ]] && by=""
  backup_result() {  # status message
    restore_py result "$updates" "$id" "$action" "$1" "$2" --name "$name" --owner "$CONDUIT_USER"
  }
  if [[ "$action" == backup ]]; then
    backup_result running "Backing up"
    log_line "backup asked for by $by"
    if log_run "$SELF" backup; then
      backup_result succeeded "The backup is at the top of the list."
    else
      backup_result failed "The backup failed (details in $UPDATER_LOG)."
    fi
  else
    backup_result running "Restoring $name"
    log_line "restore of $name asked for by $by"
    if log_run "$SELF" restore "$CONDUIT_BACKUPS/$name" "$by"; then
      backup_result succeeded "The database is back as it was in $name. The one it replaced was backed up first."
    else
      progress clear
      backup_result failed "Restoring $name failed; the database is as it was before (details in $UPDATER_LOG)."
    fi
  fi
  refresh_backup_index
}

# Internal (apply_plugin_request): back up, uninstall/reinstall what the plan says, install every listed plugin,
# migrate and restart. Arguments are "uninstall=<package>" and "reinstall=<git URL>".
cmd_apply_plugins() {
  require_root
  load_env
  progress plugins - backup
  cmd_backup
  local step
  for step in "$@"; do
    if [[ "$step" == uninstall=* ]]; then "$VENV/bin/python" -m pip uninstall --quiet --yes "${step#uninstall=}"; fi
  done
  progress plugins - install
  install_python "$(readlink -f "$APP")"
  for step in "$@"; do
    if [[ "$step" == reinstall=* ]]; then "$VENV/bin/python" -m pip install --quiet --force-reinstall --no-deps -c "$(pip_constraints)" "${step#reinstall=}"; fi
  done
  progress plugins - migrate
  finish_deploy
  progress plugins - restart
  supervisor restart "$SUPERVISOR_GROUP:*"
}

nginx_conf() {
  local conf
  for conf in ${CONDUIT_NGINX_CONF:-} /etc/nginx/sites-available/conduit.conf /etc/nginx/conf.d/conduit.conf; do
    [[ -f "$conf" ]] && { echo "$conf"; return 0; }
  done
  die "no nginx config for EvE Conduit found"
}

cmd_ip_cert() {
  # A site on a public IPv4 address instead of a domain. Let's Encrypt issues IP address certificates only with its
  # six-day "shortlived" profile, and only certbot 5.4+ can ask for them, newer than the distributions ship: it gets
  # its own venv, and its own config directory so the distribution's certbot timer never touches this certificate.
  require_root
  load_env
  local ip=${CONDUIT_SITE_URL#*://}
  ip=${ip%%[:/]*}
  [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "this site's address ($ip) isn't an IP address; a domain gets its certificate with: certbot --nginx -d $ip"
  [[ -n "${ESI_USER_AGENT_CONTACT:-}" ]] || die "set ESI_USER_AGENT_CONTACT in $ENV_FILE first (also Let's Encrypt's contact address)"
  local conf certbot="$CONDUIT_HOME/certbot/bin/certbot" uv="$CONDUIT_HOME/tools/bin/uv"
  conf=$(nginx_conf)
  if ! "$certbot" --version 2>/dev/null | grep -qE ' (5\.([4-9]|[1-9][0-9])|[6-9]|[1-9][0-9])'; then
    echo "Installing certbot 5.4 or newer in $CONDUIT_HOME/certbot"
    UV_PYTHON_INSTALL_DIR="$CONDUIT_HOME/python" "$uv" venv -q --clear --python 3.12 "$CONDUIT_HOME/certbot"
    "$uv" pip install -q -p "$CONDUIT_HOME/certbot/bin/python" 'certbot>=5.4'
  fi
  # certbot runs as root (here and from cron), so everything it writes lives in root-only directories: never in ones
  # the service user owns, where a compromised service could plant symlinks for root to follow.
  local work=${CERTBOT_STATE:-/var/lib/conduit-certbot} logs=${CERTBOT_LOG:-/var/log/conduit-certbot}
  install -d -m 0700 "$CONDUIT_ETC/letsencrypt" "$work" "$logs"
  local -a cb=("$certbot" --config-dir "$CONDUIT_ETC/letsencrypt" --work-dir "$work" --logs-dir "$logs")

  # Let's Encrypt fetches a file from /.well-known/acme-challenge/ over port 80 (configs before 0.5.17 lack it).
  install -d -m 0755 "$CONDUIT_WWW/acme"
  command -v restorecon >/dev/null && restorecon -R "$CONDUIT_WWW/acme" 2>/dev/null || true
  if ! grep -q 'acme-challenge' "$conf"; then
    local before='    location \/static\/ {'
    grep -q '    # Django static files' "$conf" && before='    # Django static files'
    sed -i "0,/$before/s##    location ^~ /.well-known/acme-challenge/ {\n        root $CONDUIT_WWW/acme;\n        default_type text/plain;\n    }\n\n&#" "$conf"
    nginx -t && systemctl reload nginx
  fi

  "${cb[@]}" certonly --webroot -w "$CONDUIT_WWW/acme" --ip-address "$ip" --preferred-profile shortlived \
    -m "$ESI_USER_AGENT_CONTACT" --agree-tos --non-interactive --keep-until-expiring --deploy-hook "systemctl reload nginx"

  # Serve HTTPS from the same server block and send plain HTTP there, as certbot --nginx does for domains.
  local live="$CONDUIT_ETC/letsencrypt/live/$ip"
  if ! grep -q "ssl_certificate $live/fullchain.pem;" "$conf"; then
    cp -a "$conf" "$conf.bak"
    sed -i "0,/server_name $ip;/s##server_name $ip;\n    listen 443 ssl;\n    listen [::]:443 ssl;\n    ssl_certificate $live/fullchain.pem;\n    ssl_certificate_key $live/privkey.pem;\n    if (\$scheme = http) { return 301 https://\$host\$request_uri; }#" "$conf"
    if nginx -t; then
      rm -f "$conf.bak"
    else
      mv "$conf.bak" "$conf"
      die "nginx didn't accept the HTTPS settings, so $conf was left as it was"
    fi
  fi
  systemctl reload nginx

  # certbot renews when about a third of the certificate's life is left (two days), so check often.
  cat > "$CRON_DIR/conduit-certbot" <<CRON
# EvE Conduit: renew the Let's Encrypt IP address certificate (valid six days). See: conduit ip-cert
17 */4 * * * root ${cb[*]} renew -q
CRON
  chmod 0644 "$CRON_DIR/conduit-certbot"
  echo "HTTPS is on: https://$ip (certificate renewed automatically)"
}

cmd_uninstall() {
  require_root
  # The script lives in the release being removed, so run a copy of it.
  local src="$APP/deploy/baremetal/uninstall.sh" tmp
  [[ -f "$src" ]] || die "$src is missing (older release?); download a release and run its deploy/baremetal/uninstall.sh"
  tmp=$(mktemp /tmp/conduit-uninstall.XXXXXX.sh)
  cp "$src" "$tmp" && chmod 700 "$tmp"
  bash "$tmp" "$@"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

cmd_run() {
  load_env
  cd "$APP/backend"
  export PATH="$VENV/bin:$PATH"
  case "${1:-}" in
    web) exec gunicorn conduit.wsgi --bind "${CONDUIT_BIND:-127.0.0.1:8000}" --workers "${WEB_WORKERS:-3}" --access-logfile - --forwarded-allow-ips 127.0.0.1 --no-control-socket ;;
    worker) exec celery -A conduit worker --loglevel INFO --queues default,sync --pool "${WORKER_POOL:-threads}" --concurrency "${WORKER_CONCURRENCY:-16}" ;;
    beat) exec celery -A conduit beat --loglevel INFO --schedule "$CONDUIT_STATE/celerybeat-schedule" ;;
    *) die "usage: conduit run web|worker|beat" ;;
  esac
}

case "${1:-}" in
  status) supervisor status "$SUPERVISOR_GROUP:*" ;;
  start | stop | restart) supervisor "$1" "$SUPERVISOR_GROUP:${2:-*}" ;;
  logs) tail -n 100 -F "$CONDUIT_LOG/${2:-web}.log" ;;
  manage) shift; manage "$@" ;;
  setup-code) manage conduit_init ;;
  upgrade) shift; cmd_upgrade "$@" ;;
  rollback) cmd_rollback ;;
  backup) cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  apply-update) cmd_apply_update ;;
  setup-updater) cmd_setup_updater ;;
  web-headers) cmd_web_headers ;;
  ip-cert) cmd_ip_cert ;;
  _apply-plugins) shift; cmd_apply_plugins "$@" ;;
  plugin) shift; cmd_plugin "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  run) shift; cmd_run "$@" ;;
  *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
