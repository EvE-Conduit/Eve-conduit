# C:\EvE-Conduit\config\conduit.env  (readable by Administrators, SYSTEM and LOCAL SERVICE only)
# install.ps1 writes this for you. After editing, run in an Administrator terminal: conduit restart

CONDUIT_SECRET_KEY=change-me-to-a-long-random-string
CONDUIT_TOKEN_KEY=
CONDUIT_SITE_URL=https://auth.example.com
CONDUIT_ALLOWED_HOSTS=auth.example.com,localhost,127.0.0.1
CONDUIT_STATIC_ROOT=C:\EvE-Conduit\data\static

# PostgreSQL (recommended; runs from <install folder>\bin\postgres) ...
DATABASE_URL=postgres://conduit:PASSWORD@127.0.0.1:5432/conduit
# ... or MariaDB:
# DATABASE_URL=mysql://conduit:PASSWORD@127.0.0.1:3306/conduit

# Garnet (Redis-compatible), installed as the conduit-garnet service, on the cache port you chose
REDIS_URL=redis://127.0.0.1:6379/0
# The EvE Conduit application, behind Caddy, on the app port you chose
CONDUIT_BIND=127.0.0.1:8000

# From https://developers.eveonline.com/applications
# Callback URL to register there: https://auth.example.com/sso/callback
ESI_CLIENT_ID=
ESI_SECRET_KEY=
ESI_USER_AGENT_CONTACT=admin@example.com

# Web ports, shown by "conduit status" (Caddy's real settings are in config\Caddyfile)
CONDUIT_HTTP_PORT=80
CONDUIT_HTTPS_PORT=443

# WEB_THREADS=8
# WORKER_CONCURRENCY=4
