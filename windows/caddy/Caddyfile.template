# EvE Conduit site for Caddy on Windows, generated by install.ps1 from windows\caddy\Caddyfile.template
# for the install folder and ports you chose. Paths are quoted so a folder with spaces works.
{
	email {{ACME_EMAIL}}
	admin off
	http_port {{HTTP_PORT}}
	https_port {{HTTPS_PORT}}{{GLOBAL_EXTRA}}
}
{{REDIRECT_BLOCK}}
{{SITE_ADDRESS}} {
{{SITE_TLS}}	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# API, EVE login and the back-office go to the application (waitress).
	@app path /api/* /sso/* /django-admin/*
	handle @app {
		reverse_proxy 127.0.0.1:{{APP_PORT}}
	}

	# Django static files, including plugin front ends.
	handle /static/* {
		uri strip_prefix /static
		root * "{{ROOT_FWD}}/data/static"
		header Cache-Control "no-cache"
		file_server
	}

	handle /assets/* {
		root * "{{ROOT_FWD}}/web"
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the single-page app. Nothing is cached: browsers check back on every load (a quick
	# 304 when nothing changed), so updates show up at once. (header runs before try_files, so match everything
	# here rather than /index.html.)
	handle {
		root * "{{ROOT_FWD}}/web"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
