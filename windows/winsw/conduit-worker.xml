<!--
  EvE Conduit worker - Windows service definition for WinSW 2.12 (https://github.com/winsw/winsw).
  The installer copies this next to a copy of WinSW named conduit-worker.exe and fills in {{...}}.
-->
<service>
  <id>conduit-worker</id>
  <name>EvE Conduit worker</name>
  <description>EvE Conduit background jobs: ESI syncs, static data, prices (Celery, thread pool).</description>
  <executable>{{ROOT}}\venv\Scripts\python.exe</executable>
  <arguments>"{{ROOT}}\app\windows\service\conduit_service.py" worker</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="CONDUIT_ROOT" value="{{ROOT}}" />
  <depend>conduit-garnet</depend>{{DB_DEPEND}}
  <startmode>Automatic</startmode>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="2 min" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>120 sec</stoptimeout>
  <logpath>{{ROOT}}\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
