<!--
  EvE Conduit MariaDB - Windows service definition for WinSW 2.12 (https://github.com/winsw/winsw).
  Runs the portable database server from the install folder. The installer fills in {{...}}.
  WinSW needs <startarguments> (not <arguments>) when a <stopexecutable> is given.
-->
<service>
  <id>conduit-mariadb</id>
  <name>EvE Conduit MariaDB</name>
  <description>MariaDB database for EvE Conduit (portable, from the install folder).</description>
  <executable>{{ROOT}}\bin\mariadb\bin\mariadbd.exe</executable>
  <startarguments>--defaults-file=&quot;{{ROOT}}\data\mariadb\my.ini&quot; --console</startarguments>
  <stopexecutable>{{ROOT}}\bin\mariadb\bin\mariadb-admin.exe</stopexecutable>
  <stoparguments>--defaults-extra-file=&quot;{{ROOT}}\config\mariadb-admin.cnf&quot; shutdown</stoparguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="CONDUIT_ROOT" value="{{ROOT}}" />
  <startmode>Automatic</startmode>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="2 min" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>90 sec</stoptimeout>
  <logpath>{{ROOT}}\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
